GEMINI_API_KEY=your-gemini-api-key-here

# Signs/verifies operator login JWTs (POST /auth/login). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate-a-long-random-secret-here

# Comma-separated list of valid X-PromptGuard-Key values every /guard/*
# call must send. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(16))"
PROMPTGUARD_API_KEYS=generate-a-random-key-here

# Optional: comma-separated extra CORS origins (beyond localhost/127.0.0.1
# and *.streamlit.app, which are always allowed). Leave unset for none.
# EXTRA_CORS_ORIGINS=https://your-custom-domain.example
