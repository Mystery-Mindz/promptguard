GEMINI_API_KEY=your-gemini-api-key-here

# Where traces/detections/approvals/operators/the llm_cache are persisted
# (app/storage.py, Prompt 4.2 -- SQLAlchemy Core, one code path for both).
# Leave unset for local dev: defaults to a SQLite file next to the repo
# (sqlite:///<repo>/promptguard.db). In production (e.g. Render, whose
# free disk is wiped on every redeploy), point this at a real Postgres
# database instead (e.g. a free Neon database) so data survives a deploy:
#   DATABASE_URL=postgresql://user:password@host/dbname
# (a bare postgresql:// URL automatically uses the psycopg (3.x) driver --
# see app/storage.py's _normalize_database_url).
# DATABASE_URL=sqlite:///promptguard.db

# Signs/verifies operator login JWTs (POST /auth/login). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate-a-long-random-secret-here

# Comma-separated list of valid X-PromptGuard-Key values every /guard/*
# call must send. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(16))"
PROMPTGUARD_API_KEYS=generate-a-random-key-here

# Optional: comma-separated extra CORS origins (beyond localhost/127.0.0.1
# and *.streamlit.app, which are always allowed). Leave unset for none.
# EXTRA_CORS_ORIGINS=https://your-custom-domain.example
